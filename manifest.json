{
    "manifest_version": 3,
    "name": "GUTO",
    "version": "1.0",
    "version_name": "V1.0",
    "description": "GUTO for Lovable.dev",
    "permissions": [
        "webRequest",
        "storage",
        "cookies",
        "sidePanel",
        "tabs",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "*://api.lovable.dev/*",
        "*://lovable.dev/*",
        "*://*.lovable.dev/*",
        "*://lovable.app/*",
        "*://*.lovable.app/*",
        "*://lovableproject.com/*",
        "*://*.lovableproject.com/*",
        "https://storage.googleapis.com/*",
        "https://*.storage.googleapis.com/*",
        "https://script.google.com/*",
        "https://script.googleusercontent.com/*",
        "https://*.supabase.co/*"
    ],
    "background": {
        "service_worker": "js/background.js"
    },
    "action": {
        "default_title": "Open GUTO",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "*://lovable.dev/*",
                "*://*.lovable.dev/*",
                "*://lovable.app/*",
                "*://*.lovable.app/*",
                "*://lovableproject.com/*",
                "*://*.lovableproject.com/*"
            ],
            "js": [
                "js/ui-compat-layer.js",
                "js/lovable-attachment-display-cleaner.js"
            ],
            "run_at": "document_end",
            "all_frames": true
        }
    ]
}
